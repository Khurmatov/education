server {
    listen {{ nginx_listen_port }};
    server_name {{ nginx_server_name }};

    root {{ lighthouse_install_dir }};
    index index.html;

    access_log /var/log/nginx/lighthouse_access.log;
    error_log /var/log/nginx/lighthouse_error.log;

    location / {
        try_files $uri $uri/ =404;
    }

    # Дополнительные настройки для статики
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Отключаем логи для favicon
    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }

    # Отключаем логи для robots.txt
    location = /robots.txt {
        log_not_found off;
        access_log off;
    }
}